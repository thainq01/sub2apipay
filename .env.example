# Database
DATABASE_URL="postgresql://sub2apipay:sub2apipay@localhost:5433/sub2apipay"

# Sub2API
SUB2API_BASE_URL="http://localhost:8080"
SUB2API_ADMIN_API_KEY=""

# Payment providers (comma-separated, e.g.: sepay)
PAYMENT_PROVIDERS=sepay
ENABLED_PAYMENT_TYPES="sepay"

# SePay config
SEPAY_API_KEY=""
SEPAY_BANK_ACCOUNT=""
SEPAY_BANK_NAME=""
SEPAY_ACCOUNT_NAME=""
SEPAY_ORDER_TIMEOUT_MINUTES="30"
SEPAY_VND_PER_CREDIT="2000"

# Coffee conversion rate (VND per 1 Coffee, defaults to SEPAY_VND_PER_CREDIT)
RATE="2000"

# Order & recharge limits
ORDER_TIMEOUT_MINUTES="5"
MIN_RECHARGE_AMOUNT="1"
MAX_RECHARGE_AMOUNT="10000"
MAX_DAILY_RECHARGE_AMOUNT="0"
#MAX_DAILY_AMOUNT_SEPAY="0"

PRODUCT_NAME="CoffeeVibeAI"

# Admin token (password for admin account, minimum 16 characters)
ADMIN_TOKEN="admin@sub2api.local"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Iframe allowed origins (comma-separated)
IFRAME_ALLOW_ORIGINS="https://example.com"

# Optional: help info displayed on payment page
#PAY_HELP_IMAGE_URL="https://example.com/qrcode.png"
#PAY_HELP_TEXT="Contact support for help"

# BSC USDT (blockchain payment)
# To enable: add bsc-usdt to PAYMENT_PROVIDERS and ENABLED_PAYMENT_TYPES
#BSC_WALLET_ADDRESS="0x..."
#BSC_RPC_URL="https://binance.llamarpc.com"
#BSC_USDT_CONTRACT="0x55d398326f99059fF775485246999027B3197955"
#BSC_REQUIRED_CONFIRMATIONS="15"
#BSC_SCAN_INTERVAL_MS="15000"
# USDT per 1 coffee (e.g., 0.1 means 1 coffee = 0.1 USDT)
#RATE_USDT="0.1"
